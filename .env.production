# Konfigurasi environment untuk build PRODUKSI.
# Next.js memuat berkas ini secara otomatis saat menjalankan `next build`
# (termasuk pada saat build di Vercel), sehingga nilai di bawah selalu
# tertanam ke dalam bundel aplikasi.
#
# Nilai ini tetap dapat ditimpa melalui Environment Variables pada dashboard
# Vercel (Project Settings -> Environment Variables) bila diperlukan.
NEXT_PUBLIC_DELCOM_BASEURL=https://open-api.delcom.org/api/v1
